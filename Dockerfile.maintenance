# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY tsconfig.json ./
COPY src ./src
COPY scripts/docker-migrate.ts scripts/docker-bootstrap-admin.ts scripts/docker-migrate-038-restore.ts ./scripts/
COPY database/migrations ./database/migrations

USER node
