# syntax=docker/dockerfile:1.7

FROM node:22-bookworm-slim

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY scripts/deploy-migration.ts ./scripts/deploy-migration.ts
COPY database/migrations/039_os_manutencao_sem_obra.sql ./database/migrations/039_os_manutencao_sem_obra.sql
COPY database/migrations/040_importacoes_contabeis.sql ./database/migrations/040_importacoes_contabeis.sql
COPY database/migrations/041_salarios_base_oficina.sql ./database/migrations/041_salarios_base_oficina.sql
COPY database/migrations/042_contabilidade_despesas_compartilhadas.sql ./database/migrations/042_contabilidade_despesas_compartilhadas.sql

USER node

# O container apenas confirma sua disponibilidade ao iniciar.
# A migration sempre precisa ser informada explicitamente no comando docker run.
CMD ["node", "--version"]
