# Copie para .env.prod somente na VPS e preencha com valores reais fora do Git.
# Não use esta senha em produção; gere uma senha longa e aleatória.
POSTGRES_DB=osgestor_prod
POSTGRES_USER=osgestor_prod_user
POSTGRES_PASSWORD=SUBSTITUA_POR_SEGREDO_ALEATORIO

# Domínio DNS apontando para a VPS. Não use example.invalid em produção.
DOMAIN=example.invalid
PUBLIC_ORIGIN=https://example.invalid
ACME_EMAIL=admin@example.invalid
